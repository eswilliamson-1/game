# Used only on your own computer for `npm run shell:deploy`. Never commit .env.
# This account must be limited to the vote subdomain's folder.
VOTE_FTP_HOST=
VOTE_FTP_USER=
VOTE_FTP_PASSWORD=
VOTE_FTP_DIR=/

# Public values, safe to ship in the browser. Row-level security protects the data.
SUPABASE_URL=
SUPABASE_ANON_KEY=
